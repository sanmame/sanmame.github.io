@article{pmsm26b,
	author  = {Masià, Melania S. and Mañas Navarrete, Iban}, 
	title   = {Una re-revisión del masculino genérico en español en respuesta a {H}eap (2024)},
	journal = {Círculo de Lingüística Aplicada a la Comunicación},
	year    = {2026},
	pages   = {277-289},
	volume  = {108},
	DOI = {10.5209/clac.98349},
	abstract = {La presencia de expresiones lingüísticas propias del lenguaje inclusivo ha experimentado un incremento constante en las últimas décadas. Tanto en medios generalistas como especializados, el debate sobre la pertinencia de estas propuestas y su capacidad para producir un cambio social relevante ha dado lugar a una fructífera producción de estudios principalmente descriptivos y normativos. Menos frecuentes han sido las investigaciones de corte empírico. A partir de la revisión sistemática que presenta Heap (2024), este trabajo analiza los diseños experimentales dirigidos a captar las interpretaciones de los hablantes sobre el llamado masculino genérico en español. Se evalúa la validez interna de los estudios, determinando si los estímulos de las pruebas representan ejemplos adecuados de masculinos genéricos, así como su validez externa, a partir del análisis de la composición y el tamaño de las muestras poblacionales seleccionadas. Los resultados identifican una serie de limitaciones metodológicas e indican posibles maneras de superarlas en futuras investigaciones.}
}

@article{pmsm26c,
	author = {Calpe Álvarez, Andrea and Rivera, Marta and Romano, Francesco and Masià, Melania S. and Guijarro-Fuentes, Pedro},
	title   = {{L}1 maintenance in typologically close languages: the role of {L}2 exposure and {L}2 performance},
	journal = {Language Acquisition},
	year    = {2026},
	number  = {},
	pages   = {},
	volume  = {},
	DOI = {10.1080/10489223.2026.2619669},
	abstract = {The present study contributes to the growing body of research showing absence of first language (L1) attrition when the L1 and second language (L2) are structurally aligned and regularly used. It investigates possible language attrition in the morphosyntactic features of 3rd-person Italian accusative clitics across three clitic structures in sequential L1-Italian–L2-Spanish speakers immersed in a Spanish-predominant environment. A total of 19 Italian–Spanish bilinguals and 18 Italian monolinguals completed a structural priming task to assess knowledge of clitic form and placement in spoken production. In the data analysis, key variables such as L2 exposure or L2 performance were also considered. We hypothesise that bilinguals will not exhibit significant variation in clitic form and placement compared to monolinguals due to the combination of continued L1 use and complete structural overlap between Italian and Spanish. However, syntactic complexity, particularly in modal constructions, was expected to influence placement and form in both groups due to processing demands. The results supported our predictions, revealing no significant differences between bilinguals and monolinguals in clitic accuracy, and lower structural accuracy in modal structures compared to lexical or causative structures in both groups. Although the present design does not allow us to isolate the mechanisms responsible for L1 maintenance, our findings offer empirical evidence that structural overlap and ongoing L1 activation can preserve grammatical stability even under intense L2 exposure.}
}

@article{pmsm26d,
	author = {Calpe Álvarez, Andrea and Guijarro-Fuentes, Pedro and Rivera, Marta and \textbf{Masià}, Melania S. and Romano, Francesco},
	title   = {{L}1 proximity and syntactic complexity in L2 {I}talian acquisition. Evidence from clitic pronouns},
	journal = {Journal of Second Language Studies},
	year    = {2026},
	number  = {},
	pages   = {},
	volume  = {},
	DOI = {10.1075/jsls.26003.cal},
	abstract = {Studies on second language acquisition suggest that clitic pronouns are challenging syntactic elements for L2ers to acquire. This study examines the acquisition of Italian accusative clitics by Spanish and Swedish L2ers. Extending Romano’s (2020) research on Swedish speakers, it employs an oral structural priming task and a speeded grammatical judgment task to examine how L1 proximity and syntactic complexity influence clitic production and processing. Both tasks included clitic left-dislocated sentences in which the host verb (lexical, quasi-functional, or functional) varied according to the hierarchy proposed by Cardinaletti and Shlonsky (2004). Results revealed that Spanish L2ers did not differ from natives but descriptively outperformed Swedish L2ers in production. Speakers’ performance varied across host verb types associated with different structural configurations. In processing, grammaticality was the main factor modulating acceptability across groups. These findings highlight the interplay between typological proximity and processing in the functional and lexical domains of L2 clitic acquisition.}
}
